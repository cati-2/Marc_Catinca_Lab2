@page
@model Marc_Catinca_Lab2.Pages.BookPages.IndexModel

@{
    ViewData["Title"] = "Books";
}

<h1>Index</h1>

<p>
    <a asp-page="/BookPages/Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Book Title</th>
            <th>Author</th>
            <th>Price</th>
            <th>PublishingDate</th>
            <th>Publisher</th>
            <th>BookCategories</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.BookD.Books)
        {
            string selectedRow = "";
            if (item.ID == Model.BookID)
            {
                selectedRow = "table-success";
            }
            <tr class="@selectedRow">
                <td>@item.Title</td>
                <td>@item.Author?.FullName</td>
                <td>@item.Price</td>
                <td>@item.PublishingDate.ToShortDateString()</td>
                <td>@item.Publisher?.PublisherName</td>
                <td>
                    @foreach (var category in item.BookCategories)
                    {
                        @category.Category.ID
                        @: @category.Category.CategoryName <br />
                    }
                </td>
                <td>
                    <a asp-page="/BookPages/Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="/BookPages/Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="/BookPages/Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>